{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "crowdbar-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-16",
	// Production route is configured but only takes effect on `wrangler deploy` (not done in Task 1).
	"routes": [{ "pattern": "api.crowdbar.dev", "custom_domain": true }],
	"workers_dev": true,
	"preview_urls": true,
	"durable_objects": {
		"bindings": [{ "name": "BAR", "class_name": "BarObject" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["BarObject"] }],
	// Previews inherit no bindings; each Preview gets its own Durable Object storage.
	"previews": {
		"durable_objects": {
			"bindings": [{ "name": "BAR", "class_name": "BarObject" }]
		}
	}
}
