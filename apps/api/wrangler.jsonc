{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "crowdbar-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-16",
	// Production route is configured but only takes effect on `wrangler deploy` (not done in Task 1).
	"routes": [{ "pattern": "api.crowdbar.dev", "custom_domain": true }],
	"workers_dev": true,
	"preview_urls": true,
	"previews": {}
}
